# ==============================================================================
# Environment Variables Example
# ==============================================================================
# Salin file ini menjadi .env.local dan isi dengan credential yang sesuai.

# 1. AI Chatbot (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Admin Authentication
ADMIN_PASSWORD=ganti_dengan_password_admin_rahasia

# 3. Upstash Redis (bisa didapatkan dari console.upstash.com atau Vercel KV Marketplace)
# Pilih salah satu format (Upstash native atau Vercel KV format):
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
# atau (jika menggunakan Vercel KV integration):
# KV_REST_API_URL=https://your-kv-url.upstash.io
# KV_REST_API_TOKEN=your_kv_token_here

# 4. Vercel Blob (bisa didapatkan dari Vercel Dashboard -> Storage -> Blob)
# Di production Vercel, variabel ini akan di-inject otomatis saat Blob Store di-link.
# Untuk local development, salin token dari Vercel Blob dashboard:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# 5. Optional: URL Website
NEXT_PUBLIC_SITE_URL=http://localhost:3000
